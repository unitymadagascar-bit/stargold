# Star Gold By TSR
# Copy the relevant values into Vercel project environment variables.

# Browser data endpoints.
# In production, keep these as relative URLs so the Vercel app reads the cloud relay API.
NEXT_PUBLIC_XAUUSD_TICK_STREAM_URL=/api/market/xauusd/stream
NEXT_PUBLIC_XAUUSD_HISTORY_URL=/api/market/xauusd/history
NEXT_PUBLIC_XAUUSD_TICK_POLL_URL=/api/market/xauusd/tick
NEXT_PUBLIC_MARKET_SERVER_UTC_OFFSET_MINUTES=0

# Local development only. The production site no longer uses localhost as a data source.
NEXT_PUBLIC_MT5_LOCAL_BRIDGE_ORIGIN=http://127.0.0.1:3000

# Preferred cloud relay: Supabase REST/Realtime database.
# Create the tables from README.md, then set these in Vercel Production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MT5_TICK_TABLE=mt5_ticks
SUPABASE_MT5_HISTORY_TABLE=mt5_candles
SUPABASE_MT5_TICK_ID=xauusd

# Optional secondary cloud persistence if Supabase is not configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MT5_REDIS_KEY_PREFIX=star-gold:mt5

# Optional bridge security. If set, put the same value in TradeTSRBridge InpBridgeToken.
MT5_BRIDGE_TOKEN=

# Market fallback. This is never live MT5 and is labeled as fallback in the app.
ALLOW_EXTERNAL_GOLD_FALLBACK=true
EODHD_API_TOKEN=
EODHD_XAUUSD_SYMBOL=XAUUSD.FOREX
YAHOO_GOLD_SYMBOL=GC=F
